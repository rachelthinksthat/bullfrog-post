---
layout: base.njk
title: The Bullfrog Post
description: A personal blog about poetry, food, travel, essays, and books.
---

<section id="home" class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <span class="eyebrow">A personal blog, hopped fresh</span>
      <h1>Stories, poems, and unfinished thoughts, told by one particularly nosy frog.</h1>
      <p class="lede">I'm Rachel — this is where I write about the food I've eaten, the places I've been, the books I can't stop thinking about, and everything in between. Grab a seat on a lily pad.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#recent">Start reading</a>
        <a class="btn btn-outline" href="#about">About Rachel</a>
      </div>
    </div>
    <img class="illus hero-header-art" src="/assets/header-frog.png" alt="A bullfrog postal courier hopping past a pond-side mailbox" width="1200" height="792">
  </div>
</section>

<section id="categories">
  <div class="wrap">
    <span class="eyebrow">Browse by kind</span>
    <div class="trail" aria-hidden="true"></div>
    <div class="cat-grid">
      <a class="cat-tile" href="/poetry/">
        <div class="wash" style="background:var(--pink)"></div>
        <img class="illus" src="/assets/quill.png" alt="" width="46" height="50.1" aria-hidden="true">
        <h3>Poetry</h3>
        <p>Short verse, mostly about weather and doubt.</p>
      </a>
      <a class="cat-tile" href="/food/">
        <div class="wash" style="background:var(--orange)"></div>
        <img class="illus" src="/assets/teacup.png" alt="" width="46" height="37" aria-hidden="true">
        <h3>Food</h3>
        <p>Reviews, recipes, and things worth queuing for.</p>
      </a>
      <a class="cat-tile" href="/travel/">
        <div class="wash" style="background:var(--fresh2)"></div>
        <img class="illus" src="/assets/suitcase.png" alt="" width="46" height="39" aria-hidden="true">
        <h3>Travel</h3>
        <p>Notes from wherever the map pointed next.</p>
      </a>
      <a class="cat-tile" href="/essays/">
        <div class="wash" style="background:var(--olive)"></div>
        <img class="illus" src="/assets/notebook.png" alt="" width="46" height="60.6" aria-hidden="true">
        <h3>Essays</h3>
        <p>Longer thoughts I couldn't fit into a poem.</p>
      </a>
      <a class="cat-tile" href="/books/">
        <div class="wash" style="background:var(--deep)"></div>
        <img class="illus" src="/assets/books.png" alt="" width="46" height="32.6" aria-hidden="true">
        <h3>Books</h3>
        <p>What I'm reading, and what I think of it.</p>
      </a>
    </div>
  </div>
</section>

<section id="recent" style="background:var(--bg-soft);border-radius:32px">
  <div class="wrap">
    <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12px">
      <h2 style="font-size:32px">Recently hopped over</h2>
      <a class="text-link" href="/poetry/">See it all sorted by kind →</a>
    </div>
    <div class="recent-list" style="margin-top:28px">
      {% for post in collections.allPosts %}
      {% if loop.index <= 4 %}
      <a class="recent-item" href="{{ post.url }}">
        <div class="recent-date">
          <span class="mon">{{ post.data.date | monthAbbr }}</span><span class="day">{{ post.data.date | dayNum }}</span>
        </div>
        <div class="recent-body">
          <div>
            <span class="tag"><span class="dot" style="background:{% if post.data.category == 'Poetry' %}var(--pink){% elif post.data.category == 'Food' %}var(--orange){% elif post.data.category == 'Travel' %}var(--fresh2){% elif post.data.category == 'Essays' %}var(--olive){% else %}var(--deep){% endif %}"></span>{{ post.data.category }}</span>
            <h3>{{ post.data.title }}</h3>
            <p>{{ post.data.excerpt }}</p>
          </div>
          {% if post.data.image %}<img class="recent-thumb" src="{{ post.data.image }}" alt="">{% endif %}
        </div>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section id="archive">
  <div class="wrap">
    <span class="eyebrow">The archive, sorted by kind</span>

    {% set catMeta = {
      "Poetry": { color: "var(--pink)", icon: "/assets/quill.png", w: 34, h: 37 },
      "Food": { color: "var(--orange)", icon: "/assets/teacup.png", w: 34, h: 27.4 },
      "Travel": { color: "var(--fresh2)", icon: "/assets/suitcase.png", w: 34, h: 28.8 },
      "Essays": { color: "var(--olive)", icon: "/assets/notebook.png", w: 34, h: 44.8 },
      "Books": { color: "var(--deep)", icon: "/assets/books.png", w: 34, h: 24.1 }
    } %}

    {% for cat in ["Poetry", "Food", "Travel", "Essays", "Books"] %}
    {% set meta = catMeta[cat] %}
    {% set catPosts = collections[cat | lower] %}
    <div class="archive-group" id="{{ cat | lower }}">
      <div class="archive-head">
        <div class="archive-badge" style="background:{{ meta.color }}"><img class="illus" src="{{ meta.icon }}" alt="" width="{{ meta.w }}" height="{{ meta.h }}" aria-hidden="true"></div>
        <h3>{{ cat }}</h3>
      </div>
      <div class="archive-posts">
        {% if catPosts.length %}
          {% for post in catPosts %}
          <div class="archive-post">
            <h4>{{ post.data.title }}</h4>
            <p>{{ post.data.excerpt }}</p>
            <a href="{{ post.url }}">Read →</a>
          </div>
          {% endfor %}
        {% else %}
          <div class="archive-post"><h4>Nothing here yet</h4><p>Check back soon — the first {{ cat | lower }} post is on its way.</p></div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<section id="about-wrap">
  <div class="wrap">
    <div class="about" id="about">
      <div class="about-inner">
        <div class="about-scene">
          <img class="illus" src="/assets/about-frog-umbrella.png" alt="A bullfrog peeking out of the water, sheltering under a lily pad" width="1026" height="753">
        </div>
        <div class="about-copy">
          <span class="eyebrow">About Rachel</span>
          <h2 style="font-size:30px">Writer, researcher, and enthusiastic noticer of small things.</h2>
          <p>[Draft — personalize this] I'm a dissertation student based in London, and The Bullfrog Post is where I write outside of it: poems, food reviews, travel notes, and essays about whatever's been sitting in my head. This site also doubles as my writing portfolio, so if you're here from a job listing, welcome — start with the essays.</p>
          <div class="about-facts">
            <div><span class="label">Based in</span><span class="value">London</span></div>
            <div><span class="label">Writing since</span><span class="value">2026</span></div>
            <div><span class="label">Currently reading</span><span class="value">[add a book]</span></div>
          </div>
          <div style="margin-top:6px">
            <span class="text-link">hello@thebullfrogpost.com</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="follow-wrap">
  <div class="wrap">
    <div class="follow" id="follow">
      <div>
        <h2>Get the next post</h2>
        <p>One email whenever I actually finish writing something. No spam, no schedule to speak of.</p>
      </div>
      <form class="follow-form" id="follow-form">
        <label for="follow-email" style="position:absolute;width:1px;height:1px;overflow:hidden">Email address</label>
        <input id="follow-email" type="email" placeholder="you@example.com" required="">
        <button class="btn btn-primary" type="submit">Subscribe</button>
      </form>
    </div>
  </div>
</section>
