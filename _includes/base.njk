<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }}{% if title != "The Bullfrog Post" %} — The Bullfrog Post{% endif %}</title>
<meta name="description" content="{{ description or 'A personal blog about poetry, food, travel, essays, and books.' }}">
<style>
  :root{
    --bg:#F5FAF0;
    --bg-soft:#E5F4E1;
    --paper:#FFFFFC;
    --ink:#162D10;
    --ink-soft:#3A4E33;
    --deep:#144D37;
    --fresh:#6ABE6F;
    --fresh2:#80CB6C;
    --olive:#78923A;
    --orange:#F2971F;
    --pink:#D77FA6;
    --line:#D7E7CE;
    color-scheme: light;
  }
  *{box-sizing:border-box}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Karla', system-ui, sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3{font-family:'Fraunces', Georgia, serif;margin:0;text-wrap:balance}
  p{margin:0}
  a{color:inherit}
  img,svg{max-width:100%}
  .wrap{max-width:1180px;margin:0 auto;padding-inline:24px;position:relative}
  .eyebrow{
    font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--deep);
  }
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'Karla',sans-serif;font-weight:700;font-size:15px;
    padding:14px 26px;border-radius:999px;border:2px solid transparent;
    cursor:pointer;text-decoration:none;
  }
  .btn:focus-visible, a:focus-visible, button:focus-visible, input:focus-visible{
    outline:3px solid var(--pink);outline-offset:2px;
  }
  .btn-primary{background:var(--orange);color:var(--ink)}
  .btn-primary:hover{background:#e08a10}
  .btn-outline{background:transparent;border-color:var(--deep);color:var(--deep)}
  .btn-outline:hover{background:var(--deep);color:var(--bg-soft)}
  .text-link{font-weight:700;color:var(--deep);text-decoration:none;border-bottom:2px solid var(--orange);padding-bottom:1px}
  .text-link:hover{color:var(--orange)}

  header{
    position:sticky;top:env(safe-area-inset-top,0px);z-index:30;
    background:rgba(245,250,240,.93);backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  .header-row{display:flex;align-items:center;justify-content:space-between;padding-block:14px;gap:16px}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);min-width:0}
  .brand span{font-family:'Fraunces',serif;font-weight:700;font-size:19px;white-space:nowrap}
  @media (max-width:360px){ .brand span{font-size:16px} }
  nav.primary{display:flex;align-items:center;gap:26px}
  nav.primary a{font-weight:600;font-size:15px;text-decoration:none;color:var(--ink);border-bottom:2px solid transparent;padding-bottom:2px}
  nav.primary a:hover, nav.primary a.active{border-bottom-color:var(--orange)}
  .menu-toggle{display:none;background:none;border:2px solid var(--deep);border-radius:10px;padding:8px 10px;cursor:pointer;flex-shrink:0}
  .mobile-panel{display:none;flex-direction:column;gap:2px;padding:8px 24px 18px;border-top:1px solid var(--line)}
  .mobile-panel a{padding:10px 4px;font-weight:600;text-decoration:none;color:var(--ink);border-bottom:1px solid var(--line)}
  @media (max-width:820px){
    nav.primary{display:none}
    .menu-toggle{display:inline-flex}
    header.open .mobile-panel{display:flex}
  }

  section{padding-block:76px;position:relative}
  @media (max-width:600px){ section{padding-block:52px} }
  @media (max-width:420px){ section{padding-block:40px} }

  .illus{display:block;max-width:none}

  .pond-strip{display:block;width:100%;height:auto;position:relative;z-index:1}
  .scatter{position:absolute;z-index:0;pointer-events:none}

  .hero{overflow:hidden}
  .hero-inner{display:flex;flex-direction:column;gap:32px;z-index:2}
  .hero-copy{display:flex;flex-direction:column;gap:20px;z-index:2;max-width:640px}
  .hero-copy h1{font-size:clamp(34px,5vw,58px);line-height:1.08;color:var(--ink)}
  .hero-copy p.lede{font-size:18px;line-height:1.6;color:var(--ink-soft);max-width:480px}
  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-top:6px}
  .hero-header-art{width:100%;max-width:720px;height:auto;align-self:center}
  @media (min-width:900px){
    .hero-inner{flex-direction:row;align-items:center;justify-content:center;gap:36px;flex-wrap:nowrap}
    .hero-copy{flex:0 1 560px;max-width:560px}
    .hero-header-art{flex:0 1 420px;max-width:420px;width:420px;align-self:center}
  }
  .blob{position:absolute;border-radius:50%;filter:blur(1px);opacity:.4}
  @keyframes hop{0%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-18px) rotate(2deg)}100%{transform:translateY(0) rotate(-2deg)}}
  @keyframes sway{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg)}}
  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  @keyframes drift{0%{transform:translateX(0) rotate(0)}100%{transform:translateX(-14px) rotate(-4deg)}}
  .hop{animation:hop 3.4s ease-in-out infinite}
  .sway{animation:sway 5s ease-in-out infinite;transform-origin:bottom center}
  .bob{animation:bob 4.4s ease-in-out infinite}
  .drift{animation:drift 6s ease-in-out infinite alternate}
  @media (prefers-reduced-motion: reduce){.hop,.sway,.bob,.drift{animation:none}}

  .cat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;position:relative;z-index:2}
  @media (max-width:900px){ .cat-grid{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @media (max-width:480px){ .cat-grid{grid-template-columns:1fr} }
  .cat-tile{
    position:relative;overflow:hidden;
    background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:26px 18px 20px;
    display:flex;flex-direction:column;align-items:flex-start;gap:10px;text-decoration:none;color:var(--ink);
  }
  .cat-tile:hover{border-color:var(--olive);transform:translateY(-3px)}
  .cat-tile .wash{position:absolute;top:-30px;right:-30px;width:110px;height:110px;border-radius:50%;opacity:.45}
  .cat-tile h3{font-size:17px;position:relative;z-index:1}
  .cat-tile p{font-size:13px;color:var(--ink-soft);line-height:1.4;position:relative;z-index:1}
  .trail{position:relative;height:1px;margin:20px 0 26px;background:repeating-linear-gradient(90deg,var(--olive) 0 10px,transparent 10px 18px);opacity:.55}

  .recent-list{display:flex;flex-direction:column;position:relative;z-index:2}
  .recent-item{
    display:flex;gap:22px;align-items:flex-start;padding-block:24px;border-bottom:1px solid var(--line);
    text-decoration:none;color:var(--ink);
  }
  .recent-item:first-child{padding-top:0}
  .recent-item:last-child{border-bottom:none}
  .recent-date{
    display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;position:relative;
    width:76px;height:76px;border-radius:50%;border:2px dashed var(--olive);background:var(--paper);
  }
  .recent-date .mon{font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--deep)}
  .recent-date .day{font-size:20px;font-weight:700;font-family:'Fraunces',serif;color:var(--ink)}
  .recent-body{flex:1 1 auto;display:flex;justify-content:space-between;gap:16px;align-items:flex-start;min-width:0}
  .tag{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-soft)}
  .tag .dot{width:9px;height:9px;border-radius:50%;display:inline-block}
  .recent-item h3{font-size:21px;margin-top:6px}
  .recent-item p{font-size:15px;color:var(--ink-soft);line-height:1.55;margin-top:6px;max-width:560px}
  .recent-thumb{flex-shrink:0;width:96px;height:72px;border-radius:12px;object-fit:cover;display:none}
  @media (min-width:700px){ .recent-thumb{display:block} }

  .archive-group{margin-top:48px;position:relative;z-index:2}
  @media (max-width:600px){ .archive-group{margin-top:32px} }
  .archive-head{display:flex;align-items:center;gap:16px;margin-bottom:20px}
  .archive-badge{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .archive-head h3{font-size:23px}
  .archive-posts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  @media (max-width:700px){ .archive-posts{grid-template-columns:1fr} }
  .archive-post{
    background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:18px 20px;
  }
  .archive-post h4{font-size:16px;font-family:'Karla',sans-serif;font-weight:700;margin-bottom:6px}
  .archive-post p{font-size:14px;color:var(--ink-soft);line-height:1.5}
  .archive-post a{font-size:13px;font-weight:700;color:var(--deep);text-decoration:none;display:inline-block;margin-top:8px}
  .archive-post a:hover{color:var(--orange)}

  .about{background:var(--bg-soft);border-radius:32px;overflow:hidden;position:relative}
  .about-inner{display:flex;gap:44px;align-items:center;flex-wrap:wrap;padding:48px;position:relative;z-index:2}
  @media (max-width:600px){ .about-inner{padding:32px 24px} }
  .about-scene{flex:1 1 360px;min-width:280px;max-width:420px}
  .about-scene img{width:100%;height:auto;display:block}
  .about-copy{flex:1 1 380px;display:flex;flex-direction:column;gap:14px}
  .about-copy p{font-size:16px;line-height:1.65;color:var(--ink-soft);max-width:560px}
  .about-facts{display:flex;gap:28px;flex-wrap:wrap;margin-top:6px}
  .about-facts div{display:flex;flex-direction:column;gap:2px}
  .about-facts .label{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--olive)}
  .about-facts .value{font-size:15px;color:var(--ink);font-weight:600}

  .follow{
    display:flex;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap;
    background:var(--deep);color:var(--bg-soft);border-radius:32px;padding:52px 48px;position:relative;overflow:hidden;z-index:2;
  }
  @media (max-width:600px){ .follow{padding:36px 28px} }
  .follow h2{color:#FFFFFB;font-size:28px;position:relative;z-index:2}
  .follow p{color:var(--bg-soft);opacity:.9;font-size:15px;margin-top:8px;max-width:420px;position:relative;z-index:2}
  form.follow-form{display:flex;gap:0;background:#FFFFFB;border-radius:999px;padding:6px;flex-wrap:wrap;position:relative;z-index:2;width:100%;max-width:420px}
  form.follow-form input{
    border:none;background:transparent;padding:12px 16px;font-family:'Karla',sans-serif;font-size:15px;
    flex:1 1 160px;min-width:0;outline:none;color:var(--ink);border-radius:999px;
  }
  form.follow-form .btn{padding:12px 22px;flex-shrink:0}

  footer{padding-block:0 44px;position:relative}
  .footer-inner{padding-top:44px}
  .footer-row{display:flex;justify-content:space-between;gap:32px;flex-wrap:wrap}
  .footer-brand{display:flex;align-items:center;gap:10px}
  .footer-cols{display:flex;gap:56px;flex-wrap:wrap}
  .footer-col{display:flex;flex-direction:column;gap:8px}
  .footer-col .label{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--olive)}
  .footer-col a{font-size:14px;text-decoration:none;color:var(--ink)}
  .footer-col a:hover{color:var(--orange)}
  .copyright{margin-top:36px;font-size:13px;color:var(--ink-soft)}

  /* category + post page additions */
  .category-hero{display:flex;align-items:center;gap:36px;flex-wrap:wrap;padding-block:56px 20px}
  @media (max-width:600px){ .category-hero{padding-block:36px 12px;gap:20px} }
  .category-hero img{width:180px;height:auto;flex-shrink:0}
  @media (max-width:480px){ .category-hero img{width:120px} }
  .category-hero h1{font-size:clamp(30px,4vw,44px)}
  .category-hero p{font-size:17px;color:var(--ink-soft);margin-top:10px;max-width:520px}
  .featured-card{
    display:flex;gap:28px;flex-wrap:wrap;text-decoration:none;color:var(--ink);
    background:var(--paper);border:1px solid var(--line);border-radius:24px;padding:20px;align-items:center;
  }
  .featured-card img{width:320px;max-width:100%;height:220px;object-fit:cover;border-radius:16px;flex-shrink:0}
  .featured-card h2{font-size:26px;margin-top:8px}
  .featured-card p{color:var(--ink-soft);font-size:15px;margin-top:8px;max-width:480px}
  .post-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:32px}
  @media (max-width:900px){ .post-grid{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @media (max-width:600px){ .post-grid{grid-template-columns:1fr} }
  .post-card{
    text-decoration:none;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:18px;
    overflow:hidden;display:flex;flex-direction:column;
  }
  .post-card:hover{border-color:var(--olive);transform:translateY(-3px)}
  .post-card img{width:100%;height:160px;object-fit:cover}
  .post-card .post-card-body{padding:16px 18px 20px;display:flex;flex-direction:column;gap:8px}
  .post-card h3{font-size:17px}
  .post-card p{font-size:14px;color:var(--ink-soft);line-height:1.5}

  .post-article{max-width:720px;margin:0 auto}
  .post-article .back-link{font-weight:700;color:var(--deep);text-decoration:none;font-size:14px}
  .post-article .post-hero{width:100%;height:auto;border-radius:20px;margin-block:20px}
  .post-article h1{font-size:clamp(30px,4vw,44px);margin-top:14px}
  .post-article time{color:var(--ink-soft);font-size:14px}
  .post-body{font-size:17px;line-height:1.75;color:var(--ink);display:flex;flex-direction:column;gap:18px}
  .post-body p{max-width:65ch}
  .post-footer-nav{display:flex;justify-content:space-between;gap:16px;margin-top:48px;padding-top:24px;border-top:1px solid var(--line);flex-wrap:wrap}
</style>
</head>
<body>

<header id="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/">
      <img class="illus" src="/assets/frog-sit.png" alt="" width="40" height="31" aria-hidden="true">
      <span>The Bullfrog Post</span>
    </a>
    <nav class="primary" aria-label="Primary">
      <a href="/poetry/">{{ categories.poetry.name }}</a>
      <a href="/food/">{{ categories.food.name }}</a>
      <a href="/travel/">{{ categories.travel.name }}</a>
      <a href="/essays/">{{ categories.essays.name }}</a>
      <a href="/books/">{{ categories.books.name }}</a>
      <a href="/film/">{{ categories.film.name }}</a>
      <a href="/#about">About</a>
    </nav>
    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-panel" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="var(--deep)" stroke-width="2.2" stroke-linecap="round"></path></svg>
    </button>
  </div>
  <nav class="mobile-panel" id="mobile-panel" aria-label="Mobile">
    <a href="/poetry/">{{ categories.poetry.name }}</a>
    <a href="/food/">{{ categories.food.name }}</a>
    <a href="/travel/">{{ categories.travel.name }}</a>
    <a href="/essays/">{{ categories.essays.name }}</a>
    <a href="/books/">{{ categories.books.name }}</a>
    <a href="/film/">{{ categories.film.name }}</a>
    <a href="/#about">About</a>
  </nav>
</header>

<main>
{{ content | safe }}
</main>

<footer>
  <div class="footer-inner" style="border-top:1px solid var(--line)">
    <div class="wrap footer-row">
      <div class="footer-brand">
        <img class="illus" src="/assets/frog-sit.png" alt="" width="30" height="23" aria-hidden="true">
        <span style="font-family:'Fraunces',serif;font-weight:700;font-size:17px">The Bullfrog Post</span>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <span class="label">Read</span>
          <a href="/poetry/">{{ categories.poetry.name }}</a>
          <a href="/food/">{{ categories.food.name }}</a>
          <a href="/travel/">{{ categories.travel.name }}</a>
          <a href="/essays/">{{ categories.essays.name }}</a>
          <a href="/books/">{{ categories.books.name }}</a>
          <a href="/film/">{{ categories.film.name }}</a>
        </div>
        <div class="footer-col">
          <span class="label">Connect</span>
          <a href="/#about">About</a>
          <a href="/#follow">Subscribe</a>
        </div>
      </div>
    </div>
    <div class="wrap">
      <p class="copyright">© 2026 The Bullfrog Post. Written slowly, delivered by frog.</p>
    </div>
  </div>
</footer>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet">

<script>
(function(){
  var header = document.getElementById('site-header');
  var toggle = document.getElementById('menu-toggle');
  var panel = document.getElementById('mobile-panel');
  if(!toggle || !header) return;
  toggle.addEventListener('click', function(){
    var open = header.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  if(panel){
    panel.querySelectorAll('a').forEach(function(link){
      link.addEventListener('click', function(){
        header.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  var form = document.getElementById('follow-form');
  if(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('button');
      var original = btn.textContent;
      btn.textContent = 'Subscribed!';
      setTimeout(function(){ btn.textContent = original; form.reset(); }, 2200);
    });
  }
})();
</script>
</body>
</html>
